KUJO_BIN=/absolute/path/to/kujo
AI_SDK_PATH=/absolute/path/to/ai-sdk/src
AI_CHAT_HOST=127.0.0.1
PORT=4173
DB_PATH=/absolute/path/to/ai-chat/data/ai_chat.db
DB_BACKUP_DIR=/absolute/path/to/ai-chat/data/backups
ENCRYPTION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
API_AUTH_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_TOKEN
ALLOWED_ORIGIN=
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_CUSTOM_PROVIDER_HOSTS=
REQUEST_TIMEOUT_MS=45000
DATA_RETENTION_DAYS=90
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_API_MAX=240
RATE_LIMIT_CHAT_MAX=60
RATE_LIMIT_STREAM_MAX=60
RATE_LIMIT_TRANSCRIBE_MAX=20
MAX_JSON_BODY_BYTES=2097152
MAX_AUDIO_UPLOAD_BYTES=10485760
MAX_MESSAGES_PER_REQUEST=200
MAX_MESSAGE_CHARS=12000
MAX_TOTAL_MESSAGE_CHARS=200000
AUDIT_LOG_PATH=/absolute/path/to/ai-chat/data/audit.log
DEBUG_API_ERRORS=0
