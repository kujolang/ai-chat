{
	"name": "ai-chat",
	"version": "1.0.0",
	"private": true,
	"description": "Modern multi-provider chat UI built with Kujo.",
	"main": "server.js",
	"engines": {
		"node": ">=22.17.0 <23",
		"npm": ">=9"
	},
	"scripts": {
		"prestart": "node scripts/ensure-native-modules.js",
		"start": "node server.js",
		"predev": "node scripts/ensure-native-modules.js",
		"dev": "node server.js",
		"rebuild:native": "npm rebuild better-sqlite3",
		"browser:install": "playwright install chromium",
		"test": "node --test tests/*.test.js",
		"test:unit": "node --test tests/*.test.js",
		"smoke": "node scripts/smoke-test.js",
		"smoke:browser": "BROWSER_EXPECTED=1 node scripts/smoke-test.js",
		"benchmark:run": "node scripts/run-benchmark-suite.js",
		"db:backup": "node scripts/backup-db.js",
		"db:vacuum": "node scripts/vacuum-db.js",
		"test:activity": "node --test tests/tool-activity-reliability.test.js"
	},
	"dependencies": {
		"better-sqlite3": "^11.7.0",
		"express": "^4.21.2",
		"multer": "^2.0.0",
		"playwright": "^1.61.1"
	}
}
